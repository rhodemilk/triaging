# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored - never commit real secrets.

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=true
MEDIA_ROOT=media
AUDIO_SUBDIR=audio
IMAGE_SUBDIR=images

# ---------------------------------------------------------------------------
# Snowflake
# ---------------------------------------------------------------------------
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=TRIAGE_ROVER
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
SNOWFLAKE_PATIENTS_TABLE=PATIENTS
SNOWFLAKE_SESSIONS_TABLE=TRIAGE_SESSIONS

# ---------------------------------------------------------------------------
# Gemini (Google GenAI) - https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_TRIAGE_SYSTEM_PROMPT=
# GEMINI_IMAGE_PROMPT=

# ---------------------------------------------------------------------------
# ElevenLabs - https://elevenlabs.io/app/settings/api-keys
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_OUTPUT_FORMAT=wav_16000
ELEVENLABS_LANGUAGE_CODE=

# ---------------------------------------------------------------------------
# Rover / Arduino
# ---------------------------------------------------------------------------
ROVER_API_KEY=
# NOTE: the NodeMCU .ino sketch can't read this .env file (it's a separate
# device). Its ssid/password/serverUrl are hardcoded constants at the top
# of the sketch by necessity - just make sure serverUrl's port matches
# FLASK_PORT above, and the path matches a real Flask route (/api/rover/ping).
